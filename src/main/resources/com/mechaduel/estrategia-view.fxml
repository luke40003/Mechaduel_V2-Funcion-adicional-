<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mechaduel.view.EstrategiaView">
    <padding>
        <Insets top="18" right="22" bottom="18" left="22"/>
    </padding>

    <Label text="SELECCIÓN DE ESTRATEGIA" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="25">
        <VBox spacing="4" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label fx:id="lblMiNombre" text="MI MECHA" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblMiStats" text="HP: 100 | ATK: 0 | DEF: 0 | SPD: 0"/>
            <Label fx:id="lblMiNrg" text="NRG: 0"/>
            <Label fx:id="lblMiEff" text="EFF: []"/>
        </VBox>

        <VBox spacing="4" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label fx:id="lblRivalNombre" text="MECHA RIVAL" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblRivalStats" text="HP: 100 | ATK: 0 | DEF: 0 | SPD: 0"/>
            <Label fx:id="lblRivalNrg" text="NRG: 0"/>
            <Label fx:id="lblRivalEff" text="EFF: []"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Estrategia a utilizar:"/>
        <ComboBox fx:id="cmbEstrategia" onAction="#onSeleccionarEstrategia" prefWidth="250"/>
    </HBox>

    <Label text="Vista previa de la estrategia:"/>
    <ListView fx:id="lvVistaPrevia" prefHeight="120" prefWidth="440"/>

    <Button fx:id="btnIniciarCombate" text="Iniciar Combate" onAction="#onIniciarCombate"/>
    <Label fx:id="lblEstado" text="Analiza al rival y elige tu estrategia."/>
</VBox>
